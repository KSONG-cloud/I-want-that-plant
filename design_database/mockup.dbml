
Table follows {
  following_user_id bigint
  followed_user_id bigint
  created_at timestamp [not null, default: `now()`]

  indexes {
    (following_user_id, followed_user_id) [pk]
  }

  checks {
    `following_user_id != followed_user_id` [name: 'user cannot follow self']
  }
}

Table favorites {
  listing_id bigint
  user_id bigint
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, listing_id) [pk]
  }
}

Table user {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  username varchar(255) [not null, unique]
  phone varchar(40)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table status {
  id bigint [pk]
  name varchar(20)

  Records {
    0, 'AVAILABLE'
    1, 'SOLDOUT'
    2, 'PENDING'
  }
}

Table currency {
  code char(3) [pk]
  name varchar(100) [not null]
  symbol varchar(8) [not null]
  decimal_places smallint [not null]

  Records {
    'AUD', 'Australia', '$', 2
  }
}

Table listing {
  id bigint [pk, increment]
  name varchar(255) [not null]
  scientific_name varchar(255)
  quantity integer [not null, check: `quantity >= 0`]
  price_perunit decimal(19, 4) [not null, check: `price_perunit >= 0`]
  currency_code char(3) [not null]
  address_line_1 varchar(255)
  address_line_2 varchar(255)
  suburb varchar(100)
  state varchar(100)
  postal_code varchar(20)
  country_code char(2)
  description text
  seller_user_id bigint [not null]
  status bigint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Ref: favorites.user_id ?> user.id

Ref: favorites.listing_id ?> listing.id

Ref: listing.status ?> status.id

Ref: listing.currency_code ?> currency.code

Ref: listing.seller_user_id ?> user.id

Ref: follows.following_user_id ?> user.id

Ref: follows.followed_user_id ?> user.id
